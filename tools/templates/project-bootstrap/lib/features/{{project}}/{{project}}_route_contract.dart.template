import 'package:laoo_shared_core/laoo_shared_core.dart';

abstract final class {{ProjectPascal}}Project {
  static const code = 'LAOO_{{PROJECT_CODE}}';
}

abstract final class {{ProjectPascal}}Routes {
  static const all = <FeatureRouteContract>[
    // Core Bootstrap lists every approved MenuCode, ScreenType, routeName and
    // routePath here. Unfinished entries stay Project-local and hidden in
    // TDADProjectMenu until their implementation PR is ready.
  ];

  static Iterable<FeatureRouteContract> get implemented =>
      all.where((route) => route.isImplemented);
}
