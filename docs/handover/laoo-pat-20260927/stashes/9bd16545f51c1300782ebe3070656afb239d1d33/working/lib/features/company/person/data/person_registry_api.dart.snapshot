import '../../../../core/api/api_client.dart';

class PersonRegistryApi {
  PersonRegistryApi({ApiClient? client, String path = _defaultPath})
    : _client = client ?? ApiClient(),
      endpointPath = path;
  final ApiClient _client;
  static const _defaultPath = '/api/company/persons';
  final String endpointPath;

  Future<Map<String, bool>> actions() async =>
      Map<String, bool>.from(await _client.get('$endpointPath/actions') as Map);
  Future<Map<String, dynamic>> list({
    String search = '',
    bool? isActive,
    bool includeEmployees = false,
    int page = 1,
    int pageSize = 20,
  }) async => Map<String, dynamic>.from(
    await _client.get(
          endpointPath,
          query: {
            'search': search,
            'page': '$page',
            'pageSize': '$pageSize',
            'includeEmployees': '$includeEmployees',
            if (isActive != null) 'isActive': '$isActive',
          },
        )
        as Map,
  );
  Future<Map<String, dynamic>> save(
    Map<String, dynamic> body, {
    int? id,
  }) async => Map<String, dynamic>.from(
    (id == null
            ? await _client.post(endpointPath, body: body)
            : await _client.put('$endpointPath/$id', body: body))
        as Map,
  );
  Future<void> delete(int id, String rowVersion) =>
      _client.delete('$endpointPath/$id', query: {'rowVersion': rowVersion});
  Future<void> addContactLink(
    int personId, {
    required String sourceProjectCode,
    required String sourceType,
    required int sourceId,
  }) => _client.post(
    '$endpointPath/$personId/contact-links',
    body: {
      'sourceProjectCode': sourceProjectCode,
      'sourceType': sourceType,
      'sourceId': sourceId,
    },
  );
  Future<void> removeContactLink(
    int personId, {
    required String sourceProjectCode,
    required String sourceType,
    required int sourceId,
  }) => _client.delete(
    '$endpointPath/$personId/contact-links',
    query: {
      'sourceProjectCode': sourceProjectCode,
      'sourceType': sourceType,
      'sourceId': '$sourceId',
    },
  );
  void dispose() => _client.dispose();
}
